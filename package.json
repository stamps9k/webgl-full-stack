{
  "name": "webgl-full-stack",
  "version": "1.0.0",
  "description": "A full stack implementation of my previous static webgl project",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "dev": "nodemon --import ./env.mjs server.mjs",
    "prod": "node server.mjs",
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "jest --verbose",
    "prepare": "husky",
    "audit:ci": "npx --yes audit-ci@7.1.0 --config audit-ci.jsonc",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stamps9k/webgl-full-stack.git"
  },
  "keywords": [],
  "author": "stampatron",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/stamps9k/webgl-full-stack/issues"
  },
  "homepage": "https://github.com/stamps9k/webgl-full-stack#readme",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "bootstrap": "5.3.3",
    "cors": "^2.8.5",
    "debug": "^4.4.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.2",
    "react-toastify": "^11.0.5",
    "wasm-model-viewer-core": "github:stamps9k/wasm-model-viewer-core-bin"
  },
  "devDependencies": {
    "@babel/core": "^7.26.8",
    "@babel/preset-env": "^7.26.8",
    "@babel/preset-react": "^7.26.3",
    "babel-jest": "^30.0.5",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.9.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.10",
    "sass": "^1.84.0",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "^14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5",
    "uuid@<11.1.1": "^11.1.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
